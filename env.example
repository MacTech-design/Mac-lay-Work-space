# Copy to .env and edit. Never commit .env.
PORT=3000

# The account with this email becomes the OWNER (dashboard access) when it signs up.
# If it already exists, run:  node server.js --make-owner you@example.com
OWNER_EMAIL=you@example.com

# Set to 1 when the site is served over HTTPS (production). Makes cookies "Secure".
PRODUCTION=0

# Optional: turns on MAC AI (calls Anthropic from the server so the key is never exposed)
ANTHROPIC_API_KEY=
AI_DAILY_LIMIT=40

# Optional: turns on Python/Java/C/C++/PHP execution through Judge0
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
